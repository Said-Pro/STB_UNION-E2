cat > /tmp/install_stb_union.sh << 'EOF'
#!/bin/sh

# ==============================================
# STB_UNION E2 - Script d'installation complet
# ==============================================

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Fonctions
print_status() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }

# Barre de progression simple (compatible busybox)
progress_bar() {
    local duration=${1}
    local i=0
    while [ $i -le 10 ]; do
        printf "${BLUE}["
        for j in $(seq 1 $i); do printf "█"; done
        for j in $(seq $i 9); do printf " "; done
        printf "] %d0%%${NC}\r" $i
        sleep $(echo "$duration/10" | bc 2>/dev/null || echo "0.3")
        i=$((i+1))
    done
    printf "\n"
}

clear
echo "=============================================="
echo "    STB_UNION E2 Installation Script"
echo "          STB_UNION E2 V1.0"
echo "=============================================="
echo ""

# Vérification de la connexion internet
print_status "Checking internet connection..."
if ping -c 1 github.com >/dev/null 2>&1; then
    print_success "Internet connection OK"
else
    print_error "No internet connection!"
    exit 1
fi

# Téléchargement
print_status "Downloading STB_UNION-E2 from GitHub..."
if wget -O /tmp/STB_UNION-E2.tar.gz https://github.com/ilyasM6/STB_UNION-E2/raw/refs/heads/main/STB_UNION-E2.tar.gz; then
    print_success "Download completed (3608 KB)"
else
    print_error "Download failed!"
    exit 1
fi

# Vérification de l'archive
print_status "Verifying archive integrity..."
if tar -tzf /tmp/STB_UNION-E2.tar.gz >/dev/null 2>&1; then
    print_success "Archive is valid"
else
    print_error "Archive is corrupted!"
    exit 1
fi

# Analyse du contenu
print_status "Analyzing archive content..."
ARCHIVE_CONTENT=$(tar -tzf /tmp/STB_UNION-E2.tar.gz | head -5)
print_success "Archive contains:"
echo "$ARCHIVE_CONTENT" | while read line; do echo "   - $line"; done

# Création du répertoire destination
DEST_DIR="/usr/lib/enigma2/python/Plugins/Extensions"
print_status "Preparing destination directory..."
mkdir -p "$DEST_DIR"
if [ -d "$DEST_DIR" ]; then
    print_success "Directory ready: $DEST_DIR"
else
    print_error "Cannot create directory!"
    exit 1
fi

# Extraction
print_status "Extracting plugin..."
cd /tmp/ || exit 1
if tar -xzf STB_UNION-E2.tar.gz -C "$DEST_DIR"; then
    print_success "Extraction completed"
else
    print_error "Extraction failed!"
    exit 1
fi

# Vérification post-extraction
print_status "Verifying installation..."
PLUGIN_FOLDER=$(tar -tzf STB_UNION-E2.tar.gz 2>/dev/null | head -1 | cut -d'/' -f1)

if [ -n "$PLUGIN_FOLDER" ] && [ -d "$DEST_DIR/$PLUGIN_FOLDER" ]; then
    print_success "Plugin folder found: $DEST_DIR/$PLUGIN_FOLDER"
    
    # Vérification des fichiers importants
    if [ -f "$DEST_DIR/$PLUGIN_FOLDER/__init__.py" ] || [ -f "$DEST_DIR/$PLUGIN_FOLDER/plugin.py" ]; then
        print_success "Plugin structure is valid"
    else
        print_warning "Plugin installed but main files may be missing"
    fi
    
    # Comptage des fichiers
    NB_FILES=$(find "$DEST_DIR/$PLUGIN_FOLDER" -type f 2>/dev/null | wc -l)
    print_success "$NB_FILES files installed"
    
    # Affichage du contenu
    print_status "Plugin contents:"
    ls -la "$DEST_DIR/$PLUGIN_FOLDER/" | head -10 | tail -8
else
    print_error "Plugin verification failed!"
    exit 1
fi

# Nettoyage
print_status "Cleaning temporary files..."
rm -f /tmp/STB_UNION-E2.tar.gz
rm -rf /tmp/STB_UNION-E2*
print_success "Temporary files removed"

# Option de redémarrage
echo ""
echo "=============================================="
print_status "Receiver restart option"
echo "=============================================="
echo ""
echo "Do you want to restart the receiver now?"
echo ""
echo "  1) Yes, restart now (recommended)"
echo "  2) No, I will restart manually later"
echo ""
printf "Choose option (1 or 2): "
read -r RESTART_OPTION

case $RESTART_OPTION in
    1)
        print_status "Restarting the receiver..."
        progress_bar 2
        
        if command -v systemctl >/dev/null 2>&1; then
            systemctl restart enigma2
        elif [ -f /etc/init.d/enigma2 ]; then
            /etc/init.d/enigma2 restart
        elif command -v init >/dev/null 2>&1; then
            init 6
        elif command -v reboot >/dev/null 2>&1; then
            reboot
        else
            print_error "Cannot restart automatically. Please restart manually."
            exit 1
        fi
        
        echo ""
        print_success "Installation completed! Receiver is restarting..."
        ;;
    2)
        print_success "Installation completed successfully!"
        print_warning "Please restart your receiver manually to activate the plugin"
        echo ""
        echo "Restart commands:"
        echo "  - systemctl restart enigma2"
        echo "  - init 6"
        echo "  - reboot"
        ;;
    *)
        print_error "Invalid option!"
        exit 1
        ;;
esac

echo ""
echo "=============================================="
print_success "STB_UNION E2 has been installed"
echo "=============================================="
EOF

# Rendre le script exécutable
chmod +x /tmp/install_stb_union.sh

# Exécuter le script
/tmp/install_stb_union.sh
