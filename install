#!/bin/sh

# ألوان للتنسيق
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# دالة للطباعة الملونة
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# دالة شريط التقدم
progress_bar() {
    local duration=${1}
    local bars=20
    local sleep_interval=$(echo "scale=3; $duration/$bars" | bc)
    
    for ((i=0; i<=bars; i++)); do
        printf "${BLUE}["
        for ((j=0; j<i; j++)); do printf "█"; done
        for ((j=i; j<bars; j++)); do printf " "; done
        printf "] %3d%%${NC}\r" $((i*100/bars))
        sleep $sleep_interval
    done
    printf "\n"
}

clear
echo "=============================================="
echo "    STB_UNION E2 Installation Script"
echo "          STB_UNION E2 V1.0"
echo "=============================================="
echo ""

# التحقق من الاتصال بالإنترنت
print_status "Checking internet connection..."
if ping -c 1 github.com >/dev/null 2>&1; then
    print_success "Internet connection is available"
else
    print_error "No internet connection!"
    exit 1
fi

# التنزيل
print_status "Downloading STB_UNION-E2 from GitHub..."
if wget -O /tmp/STB_UNION-E2.tar.gz https://github.com/ilyasM6/STB_UNION-E2/raw/refs/heads/main/STB_UNION-E2.tar.gz; then
    print_success "Download completed successfully"
else
    print_error "Download failed!"
    exit 1
fi

# ==============================================
# فك الضغط وتثبيت الملفات
# ==============================================

# التأكد من وجود المجلد الوجهة
DEST_DIR="/usr/lib/enigma2/python/Plugins/Extensions"
PLUGIN_NAME="STB_UNION E2"

print_status "Checking destination directory..."

if [ ! -d "$DEST_DIR" ]; then
    print_warning "Destination directory does not exist. Creating it..."
    if mkdir -p "$DEST_DIR"; then
        print_success "Directory created: $DEST_DIR"
    else
        print_error "Failed to create directory: $DEST_DIR"
        exit 1
    fi
else
    print_success "Destination directory exists"
fi

# فك الضغط
print_status "Extracting $PLUGIN_NAME to plugins directory..."
cd /tmp/ || exit 1

# فك الضغط مباشرة إلى المجلد الوجهة
if tar -xzf STB_UNION-E2.tar.gz -C "$DEST_DIR"; then
    print_success "Extraction completed successfully"
    print_success "$PLUGIN_NAME has been installed to: $DEST_DIR"
else
    print_error "Extraction failed!"
    print_error "Please check if the archive is corrupted or destination is writable"
    exit 1
fi

# ==============================================
# تنظيف الملفات المؤقتة (حذف كل آثار STB_UNION-E2 من /tmp)
# ==============================================

print_status "Cleaning all temporary files from /tmp..."

# حذف الملف المضغوط
if [ -f /tmp/STB_UNION-E2.tar.gz ]; then
    rm -f /tmp/STB_UNION-E2.tar.gz
    print_success "Removed: /tmp/STB_UNION-E2.tar.gz"
else
    print_warning "Archive file not found in /tmp"
fi

# حذف أي مجلد مستخرج في /tmp (إذا وجد)
if [ -d /tmp/STB_UNION-E2 ]; then
    rm -rf /tmp/STB_UNION-E2
    print_success "Removed directory: /tmp/STB_UNION-E2"
fi

# حذف أي ملفات أو مجلدات أخرى تحمل نفس الاسم
for item in /tmp/STB_UNION-E2*; do
    if [ "$item" != "/tmp/STB_UNION-E2*" ] && [ -e "$item" ]; then
        rm -rf "$item"
        print_success "Removed: $item"
    fi
done

print_success "All traces of STB_UNION-E2 have been removed from /tmp"

# ==============================================
# إعادة تشغيل الجهاز (الريسيفر)
# ==============================================

print_status "Restarting the receiver..."
print_warning "Please wait while the receiver restarts..."
progress_bar 3

# محاولة طرق مختلفة لإعادة التشغيل
if command -v systemctl >/dev/null 2>&1; then
    # نظام systemd
    print_status "Using systemctl to restart enigma2..."
    systemctl restart enigma2
elif [ -f /etc/init.d/enigma2 ]; then
    # نظام init.d التقليدي
    print_status "Using init.d script to restart enigma2..."
    /etc/init.d/enigma2 restart
elif command -v init >/dev/null 2>&1; then
    # إعادة تشغيل كاملة للجهاز
    print_status "Performing full system reboot..."
    init 6
elif command -v reboot >/dev/null 2>&1; then
    # أمر reboot
    print_status "Rebooting the system..."
    reboot
else
    print_error "Cannot restart automatically. Please restart your receiver manually."
    exit 1
fi

echo ""
echo "=============================================="
print_success "Installation completed successfully!"
print_success "$PLUGIN_NAME has been installed and activated"
print_success "The receiver is now restarting..."
echo "=============================================="
echo ""
