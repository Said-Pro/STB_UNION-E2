#!/bin/sh

# ألوان للتنسيق
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# دالة للطباعة الملونة
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# دالة شريط التقدم
progress_bar() {
    local duration=${1}
    local bars=20
    local sleep_interval=$(echo "scale=3; $duration/$bars" | bc)
    
    for ((i=0; i<=bars; i++)); do
        printf "${BLUE}["
        for ((j=0; j<i; j++)); do printf "█"; done
        for ((j=i; j<bars; j++)); do printf " "; done
        printf "] %3d%%${NC}\r" $((i*100/bars))
        sleep $sleep_interval
    done
    printf "\n"
}

clear
echo "=============================================="
echo "    STB_UNION E2 Installation Script"
echo "          STB_UNION E2 V1.0"
echo "=============================================="
echo ""

# التحقق من الاتصال بالإنترنت
print_status "Checking internet connection..."
if ping -c 1 github.com >/dev/null 2>&1; then
    print_success "Internet connection is available"
else
    print_error "No internet connection!"
    exit 1
fi

# التنزيل
print_status "Downloading STB_UNION-E2 from GitHub..."
if wget -O /tmp/STB_UNION-E2.tar.gz https://github.com/ilyasM6/STB_UNION-E2/raw/refs/heads/main/STB_UNION-E2.tar.gz; then
    print_success "Download completed successfully"
else
    print_error "Download failed!"
    exit 1
fi

# ==============================================
# فك الضغط (SECTION AMÉLIORÉE)
# ==============================================

# التأكد من وجود المجلد الوجهة
DEST_DIR="/usr/lib/enigma2/python/Plugins/Extensions"
print_status "Checking destination directory..."

if [ ! -d "$DEST_DIR" ]; then
    print_warning "Destination directory does not exist. Creating it..."
    if mkdir -p "$DEST_DIR"; then
        print_success "Directory created: $DEST_DIR"
    else
        print_error "Failed to create directory: $DEST_DIR"
        exit 1
    fi
else
    print_success "Destination directory exists"
fi

# فك الضغط
print_status "Extracting files to plugins directory..."
cd /tmp/ || exit 1

# فك الضغط مع عرض المحتويات
print_status "Extracting archive contents..."
if tar -xzf STB_UNION-E2.tar.gz -C "$DEST_DIR" 2>&1; then
    print_success "Extraction completed successfully"
    
    # عرض اسم المجلد المستخرج للتحقق
    EXTRACTED_DIR=$(tar -tzf STB_UNION-E2.tar.gz | head -1 | cut -d '/' -f1)
    if [ -n "$EXTRACTED_DIR" ] && [ -d "$DEST_DIR/$EXTRACTED_DIR" ]; then
        print_success "Plugin extracted to: $DEST_DIR/$EXTRACTED_DIR"
    else
        print_warning "Plugin extracted but folder structure may be different"
    fi
else
    print_error "Extraction failed!"
    print_error "Please check if the archive is corrupted or destination is writable"
    exit 1
fi

# ==============================================
# تنظيف الملف المؤقت (SECTION AMÉLIORÉE)
# ==============================================

print_status "Cleaning temporary files..."

# حذف الملف المضغوط المؤقت
if rm -f /tmp/STB_UNION-E2.tar.gz; then
    print_success "Temporary archive removed: /tmp/STB_UNION-E2.tar.gz"
else
    print_warning "Could not remove temporary archive (may not exist or permission denied)"
fi

# تنظيف أي ملفات مؤقتة أخرى (اختياري)
if [ -d "/tmp/STB_UNION-E2" ]; then
    rm -rf /tmp/STB_UNION-E2
    print_success "Temporary extraction directory cleaned"
fi

print_success "All temporary files have been removed"

# ==============================================
# CONTINUATION DU SCRIPT
# ==============================================

# تثبيت الحزم المطلوبة
print_status "Updating package list and installing dependencies..."
print_warning "This may take a few minutes..."
progress_bar 5

if opkg update; then
    print_success "Package list updated"
else
    print_error "Failed to update package list (opkg not found or network issue)"
    # Continue anyway, as dependencies might already be installed
fi

# إعادة التشغيل
print_status "Restarting Enigma2..."
print_warning "Please wait while the system restarts..."
progress_bar 3

if command -v systemctl >/dev/null 2>&1; then
    systemctl restart enigma2
else
    print_warning "systemctl not found, trying init.d method"
    if [ -f /etc/init.d/enigma2 ]; then
        /etc/init.d/enigma2 restart
    else
        print_error "Cannot restart Enigma2 automatically. Please restart manually."
        exit 1
    fi
fi

echo ""
echo "=============================================="
print_success "Installation completed successfully!"
print_success "STB_UNION E2 has been installed and activated"
echo "=============================================="
echo ""
