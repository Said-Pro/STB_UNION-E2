#!/bin/sh

# ألوان للتنسيق
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_status()  { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
print_error()   { echo -e "${RED}[ERROR]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }

clear
echo "=============================================="
echo "    STB_UNION E2 Installation Script"
echo "          STB_UNION E2 V1.0"
echo "=============================================="
echo ""

# ── 1. Vérification internet ──────────────────────────────
print_status "Checking internet connection..."
if ping -c 1 github.com >/dev/null 2>&1; then
    print_success "Internet connection is available"
else
    print_error "No internet connection!"
    exit 1
fi

# ── 2. Téléchargement ─────────────────────────────────────
print_status "Downloading STB_UNION-E2 from GitHub..."
wget -O /tmp/STB_UNION-E2.tar.gz \
  https://github.com/ilyasM6/STB_UNION-E2/raw/refs/heads/main/STB_UNION-E2.tar.gz

if [ $? -ne 0 ] || [ ! -s /tmp/STB_UNION-E2.tar.gz ]; then
    print_error "Download failed or file is empty!"
    exit 1
fi
print_success "Download completed successfully"

# ── 3. Extraction DIRECTE vers le dossier des plugins ─────
DEST="/usr/lib/enigma2/python/Plugins/Extensions"
print_status "Extracting directly to $DEST ..."

# Créer le dossier de destination s'il n'existe pas
mkdir -p "$DEST"

# Supprimer l'ancienne version si elle existe
if [ -d "$DEST/STB_UNION E2" ]; then
    print_warning "Removing old version..."
    rm -rf "$DEST/STB_UNION E2"
fi

# Extraire l'archive directement dans le dossier Extensions
tar -xzf /tmp/STB_UNION-E2.tar.gz -C "$DEST"

if [ $? -ne 0 ]; then
    print_error "Extraction failed!"
    exit 1
fi
print_success "Archive extracted successfully to $DEST"

# ── 4. Renommer le dossier extrait (si nécessaire) ────────
print_status "Checking extracted folder name..."

# Chercher le dossier qui vient d'être extrait (nom variable selon l'archive)
EXTRACTED=$(find "$DEST" -maxdepth 1 -type d -name "STB_UNION*" ! -name "STB_UNION E2" | head -n 1)

if [ -n "$EXTRACTED" ] && [ "$EXTRACTED" != "$DEST/STB_UNION E2" ]; then
    print_status "Renaming '$EXTRACTED' to 'STB_UNION E2'..."
    mv "$EXTRACTED" "$DEST/STB_UNION E2"
    if [ $? -ne 0 ]; then
        print_error "Rename failed!"
        exit 1
    fi
    print_success "Folder renamed to 'STB_UNION E2'"
else
    print_success "Folder already has correct name or no rename needed"
fi

# ── 5. Supprimer le fichier temporaire ────────────────────
print_status "Removing temporary file..."
rm -f /tmp/STB_UNION-E2.tar.gz

if [ $? -ne 0 ]; then
    print_warning "Could not remove temporary file, but installation continues"
else
    print_success "Temporary file deleted: /tmp/STB_UNION-E2.tar.gz"
fi

# ── 6. Vérification finale de l'installation ──────────────
if [ -d "$DEST/STB_UNION E2" ]; then
    print_success "Plugin successfully installed at: $DEST/STB_UNION E2"
    ls -la "$DEST/STB_UNION E2" | head -5
else
    print_error "Plugin installation failed! Folder not found."
    exit 1
fi

# ── 7. Redémarrage d'Enigma2 ──────────────────────────────
echo ""
print_status "Restarting Enigma2..."
print_warning "Please wait while the system restarts..."

# Méthodes de redémarrage (ordre de priorité)
if command -v init >/dev/null 2>&1; then
    print_status "Restarting via init 4 && init 3..."
    init 4 && init 3
elif command -v systemctl >/dev/null 2>&1; then
    print_status "Restarting via systemctl..."
    systemctl restart enigma2
elif [ -f /etc/init.d/enigma2 ]; then
    print_status "Restarting via init.d..."
    /etc/init.d/enigma2 restart
else
    print_error "Cannot restart automatically. Please restart manually."
    exit 1
fi

echo ""
echo "=============================================="
print_success "Installation completed successfully!"
print_success "STB_UNION E2 is installed and active"
echo "=============================================="
echo ""
